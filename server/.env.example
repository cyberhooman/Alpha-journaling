PORT=5000
NODE_ENV=development

# Database - PostgreSQL (recommended for production)
# If DATABASE_URL is not set, SQLite will be used as fallback
# Railway/Heroku format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trading_journal

# Legacy database config (not used if DATABASE_URL is set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_journal
DB_USER=postgres
DB_PASSWORD=postgres

# JWT - CRITICAL SECURITY SETTING
# REQUIRED: Must be at least 32 characters long
# Generate a secure random string for production:
# - On Linux/Mac: openssl rand -base64 32
# - On Windows: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER commit the actual secret to version control
JWT_SECRET=your-secret-key-change-this-in-production-MUST-BE-AT-LEAST-32-CHARS
JWT_EXPIRES_IN=7d

# CORS - Security Configuration
# Comma-separated list of allowed origins
# Example: ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain.com
# Only these domains will be able to access your API
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
