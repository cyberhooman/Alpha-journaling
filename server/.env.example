PORT=5000
NODE_ENV=development
TRUST_PROXY=false

# Database - PostgreSQL (recommended for production)
# If DATABASE_URL is not set, SQLite will be used as fallback
# Railway/Heroku format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trading_journal

# Legacy database config (not used if DATABASE_URL is set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_journal
DB_USER=postgres
DB_PASSWORD=postgres

# JWT - CRITICAL SECURITY SETTING
# REQUIRED: Must be at least 32 characters long
# Generate a secure random string for production:
# - On Linux/Mac: openssl rand -base64 32
# - On Windows: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER commit the actual secret to version control
JWT_SECRET=your-secret-key-change-this-in-production-MUST-BE-AT-LEAST-32-CHARS
JWT_EXPIRES_IN=7d

# CORS - Security Configuration
# Comma-separated list of allowed origins
# Example: ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain.com
# Only these domains will be able to access your API
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
#
# Production example (custom domain):
# ALLOWED_ORIGINS=https://0xalphalabs-journaling.xyz,https://www.0xalphalabs-journaling.xyz

# Google OAuth Configuration
# Obtain credentials from: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID (Web application type)
# Add authorized origins: http://localhost:5173, http://localhost:5000
# Add redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Session Secret for Passport (required for OAuth)
# Generate a secure random string:
# - On Linux/Mac: openssl rand -base64 32
# - On Windows: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=your-session-secret-at-least-32-characters-long

# Frontend URL for OAuth redirects
FRONTEND_URL=http://localhost:5173
#
# Production example (custom domain):
# FRONTEND_URL=https://0xalphalabs-journaling.xyz
