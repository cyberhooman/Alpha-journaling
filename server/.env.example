PORT=5000
NODE_ENV=development

# Database - PostgreSQL (recommended for production)
# If DATABASE_URL is not set, SQLite will be used as fallback
# Railway/Heroku format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trading_journal

# Legacy database config (not used if DATABASE_URL is set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_journal
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000
